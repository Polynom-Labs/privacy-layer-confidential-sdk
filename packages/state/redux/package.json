{
  "name": "@arcane/privacy-sdk-state-redux",
  "version": "0.1.0",
  "description": "Redux Toolkit state bridge adapter for the Arcane privacy SDK",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@arcane/privacy-sdk-core": "0.1.0",
    "@reduxjs/toolkit": "^2.6.1"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": "^2.0.0"
  },
  "sideEffects": false,
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  }
}
