{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "plugins": [
    "node-workspace"
  ],
  "packages": {
    "packages/core": {
      "component": "privacy-sdk-core",
      "release-type": "node"
    },
    "packages/relay": {
      "component": "privacy-sdk-relay",
      "release-type": "node"
    },
    "packages/stellar": {
      "component": "privacy-sdk-stellar",
      "release-type": "node"
    },
    "packages/state/redux": {
      "component": "privacy-sdk-state-redux",
      "release-type": "node"
    },
    "packages/state/memory": {
      "component": "privacy-sdk-state-memory",
      "release-type": "node"
    }
  }
}